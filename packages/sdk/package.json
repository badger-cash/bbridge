{
  "name": "@bbridge/sdk",
  "version": "0.1.2",
  "description": "Reference TypeScript client for the eCash (XEC) <-> Ethereum bridge",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/src",
    "src",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/badger-cash/bbridge.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/badger-cash/bbridge/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/badger-cash/bbridge/issues"
  },
  "keywords": [
    "ecash",
    "xec",
    "slp",
    "bridge",
    "ethereum",
    "covenant"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-ambient-types.js",
    "test": "npm run build && node --test dist/test",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@hansekontor/checkout-components": ">=1.0.1 <1.3.0"
  },
  "dependencies": {
    "bsert": "^0.0.13",
    "bufio": "^1.2.1",
    "n64": "^0.2.10"
  },
  "devDependencies": {
    "@hansekontor/checkout-components": "1.1.0",
    "@types/node": "^18.19.130",
    "typescript": "^7.0.2"
  }
}
