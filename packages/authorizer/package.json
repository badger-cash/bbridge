{
  "name": "@bbridge/authorizer",
  "version": "0.2.0",
  "description": "Reference implementation of the bbridge Authorizer service core: deposit confirmation with vault UTXO quarantine, and withdrawal postage co-signing",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/src",
    "src",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/badger-cash/bbridge.git",
    "directory": "packages/authorizer"
  },
  "homepage": "https://github.com/badger-cash/bbridge/tree/main/packages/authorizer#readme",
  "bugs": {
    "url": "https://github.com/badger-cash/bbridge/issues"
  },
  "keywords": [
    "ecash",
    "xec",
    "slp",
    "bridge",
    "ethereum",
    "authorizer"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/reference-sdk-types.js",
    "test": "npm run build && node --test dist/test",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@bbridge/sdk": "^0.1.1"
  },
  "peerDependencies": {
    "@hansekontor/checkout-components": ">=1.0.1 <1.3.0"
  },
  "devDependencies": {
    "@hansekontor/checkout-components": "1.1.0",
    "@types/node": "^18.19.130",
    "typescript": "^7.0.2"
  }
}
